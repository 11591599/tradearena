# TradeArena configuration template. Copy to .env on the server and fill only there.
# Never commit the real .env file or paste bot tokens into issues/chat.

# Required to enable Telegram bot and secure Mini App authentication.
TELEGRAM_BOT_TOKEN=

# Required: public HTTPS URL serving the built Mini App (for example https://arena.example.com).
WEBAPP_URL=

# Optional. Internal API address used by the bot leaderboard command.
INTERNAL_API_URL=http://127.0.0.1:8000/api

# Database. Docker Compose overrides this with a persistent /app/data path.
DATABASE_URL=sqlite+aiosqlite:///./tradearena.db

# Optional external wallet/payment integration; not required to start the bot or app.
TON_WALLET_ADDRESS=
TON_API_KEY=
TONCENTER_API_URL=https://api.toncenter.com/v1

# Optional game tuning.
STARTING_BALANCE=10000
ROUND_DURATION_MINUTES=60
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
